@page "/closures"
@inherits WorkspacePage

<PageTitle>Closures — Deskovia</PageTitle>
<h1>Close an office or room</h1>
<Feedback Busy="Busy" Error="@Error" Notice="@Notice" />
@if (Api.Admin)
{
<fieldset disabled="@Busy">
    <section class="panel">
        <div class="toolbar">
            <label>Office <select @bind="officeId" @bind:after="SelectOffice"><option value="">Select</option>@foreach (var o in offices) { <option value="@o.Id">@o.Name</option> }</select></label>
            <label>Room <select @bind="roomId" @bind:after="Invalidate"><option value="">Entire office</option>@foreach (var r in rooms) { <option value="@r.Id">@r.Name</option> }</select></label>
        </div>
        <p>Enter times in the office time zone: @office?.TimeZoneId. Future overlapping reservations are cancelled in full; ongoing occupancy ends when a closure takes effect immediately.</p>
        <div class="toolbar">
            <label>Start <input type="datetime-local" @bind="start" @bind:after="Invalidate" /></label>
            <label>End <input type="datetime-local" @bind="end" @bind:after="Invalidate" /></label>
            <label>Reason <input @bind="reason" @bind:after="Invalidate" maxlength="1000" /></label>
            <button @onclick="Preview" disabled="@(office == null)">Preview affected reservations</button>
        </div>
        @if (preview != null)
        {
            <h2>Reservations affected: @preview.Count</h2>
            @foreach (var r in preview) { <p>@r.Member · @r.Room / @r.Desk · @Local(r.Start, r.TimeZoneId) — @Local(r.End, r.TimeZoneId)</p> }
            <button class="primary" @onclick="Close">Confirm closure and resolve listed reservations</button>
        }
    </section>
    <h2>Existing closures</h2>
    @if (closures.Count == 0) { <p>No closures.</p> }
    @foreach (var c in closures)
    {
        var o = offices.FirstOrDefault(x => x.Id == c.OfficeId);
        <article class="panel"><h3>@o?.Name · @c.Reason</h3><p>@(o == null ? c.Start.ToString() : Local(c.Start, o.TimeZoneId)) — @(o == null ? c.End.ToString() : Local(c.End, o.TimeZoneId)) · @(c.Cancelled ? "Cancelled" : "Active")</p>
        @if (!c.Cancelled) { <button @onclick="() => Cancel(c.Id)">Cancel closure (reservations will not be restored)</button> }</article>
    }
</fieldset>
}
@code {
    private List<OfficeView> offices = [];
    private OfficeView? office;
    private List<RoomView> rooms = [];
    private List<ClosureView> closures = [];
    private List<ReservationView>? preview;
    private string officeId = "", roomId = "", reason = "";
    private DateTime start = DateTime.Today.AddDays(1).AddHours(7), end = DateTime.Today.AddDays(1).AddHours(18);
    protected override Task OnInitializedAsync() => Run(async () =>
    {
        if (!await Api.Ensure()) return;
        if (!Api.Admin) { Error = "You do not have permission to perform this action."; return; }
        offices = await Api.Get<List<OfficeView>>("api/offices?archived=true"); await LoadClosures();
    });
    private async Task LoadClosures() => closures = await Api.Get<List<ClosureView>>("api/admin/closures");
    private void Invalidate() => preview = null;
    private Task SelectOffice() => Run(async () =>
    {
        Invalidate(); roomId = ""; office = offices.FirstOrDefault(x => x.Id.ToString() == officeId);
        rooms = office == null ? [] : (await Api.Get<OfficeMap>($"api/offices/{office.Id}/map")).Rooms;
        if (office != null) { start = office.Today.AddDays(1).ToDateTime(new(7, 0)); end = office.Today.AddDays(1).ToDateTime(new(18, 0)); }
    });
    private DateTimeOffset Utc(DateTime local)
    {
        var zone = TimeZoneInfo.FindSystemTimeZoneById(office!.TimeZoneId);
        local = DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
        if (zone.IsInvalidTime(local) || zone.IsAmbiguousTime(local)) throw new InvalidOperationException();
        return new(TimeZoneInfo.ConvertTimeToUtc(local, zone));
    }
    private ClosureRequest Input() => new(office!.Id, Guid.TryParse(roomId, out var r) ? r : null, Utc(start), Utc(end), reason, preview?.Select(x => x.Id).ToList());
    private Task Preview() => Run(async () => preview = await Api.Post<List<ReservationView>>("api/admin/closures/preview", Input()));
    private Task Close() => Run(async () =>
    {
        try { await Api.Post<Guid>("api/admin/closures", Input()); preview = null; await LoadClosures(); Notice = "Closure saved."; }
        catch (ApiException e) when (e.Status == 409) { preview = await Api.Post<List<ReservationView>>("api/admin/closures/preview", Input()); throw; }
    });
    private Task Cancel(Guid id) => Run(async () => { await Api.Action($"api/admin/closures/{id}/cancel"); await LoadClosures(); Notice = "Closure cancelled; cancelled reservations have not been restored."; });
}
