@page "/owner"
@inherits WorkspacePage

<PageTitle>Owner tools — Deskovia</PageTitle>
<h1>Owner demonstration tools</h1>
<Feedback Busy="Busy" Error="@Error" Notice="@Notice" />
@if (Api.Owner)
{
<fieldset disabled="@Busy">
    <section class="panel">
        <h2>Daily demo directory check</h2>
        <p>Configure records on the Members page. Disabled/Deleted disable accounts; Unavailable leaves access unchanged. Local accounts without a demo record are not checked.</p>
        <p>Last run (UTC): @directory?.LastRun · @directory?.Result</p>
        <button @onclick="Sync">Run the check now</button>
    </section>
    <h2>Test mailbox / outbox</h2>
    <button @onclick="Refresh">Refresh</button>
    @if (notifications.Count == 0) { <p>No messages yet.</p> }
    @foreach (var n in notifications)
    {
        <article class="panel"><h3>@n.Subject</h3><p>@n.Recipient · @n.Status · attempts: @n.Attempts</p><p>Scheduled (UTC): @n.ScheduledAt · delivered: @n.SentAt</p><p class="mail">@n.Body</p>@if (n.Error != null) { <p class="error">@n.Error</p> }</article>
    }
</fieldset>
}
@code {
    private DirectoryRunView? directory;
    private List<NotificationView> notifications = [];
    protected override Task OnInitializedAsync() => Run(async () => { if (await Api.Ensure()) { if (!Api.Owner) { Error = "You do not have permission to perform this action."; return; } await Load(); } });
    protected override Task OnConflict() => Load();
    private async Task Load()
    {
        directory = await Api.Get<DirectoryRunView>("api/owner/demo-directory");
        notifications = await Api.Get<List<NotificationView>>("api/owner/notifications");
    }
    private Task Refresh() => Run(Load);
    private Task Sync() => Run(async () => { await Api.Action("api/owner/demo-directory/sync"); await Load(); Notice = "Check completed."; });
}
